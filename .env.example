# ==============================================================================
# SECURE E-VOTING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in production and replace with secure secrets.
# DO NOT COMMIT SENSITIVE SECRETS TO SOURCE CONTROL.

PROJECT_NAME="Secure E-Voting System"
API_V1_STR="/api/v1"

# JWT Authentication secret key (Generate via: openssl rand -hex 32)
SECRET_KEY="generate_a_secure_random_64_character_hex_secret_here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database connection (SQLite for local demo; can use PostgreSQL in production)
DATABASE_URL="sqlite:///evoting.db"

# Master Authority 256-bit encryption key (64 hex characters)
# Used for HKDF-SHA256 key derivation across Feistel rounds and Encrypt-then-MAC
ELECTION_AUTHORITY_MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Authority Ed25519 Signing Key (Optional: leave empty to auto-generate a fresh ephemeral key on startup)
AUTHORITY_ED25519_PRIVATE_KEY_PEM=""

# Allowed CORS origins for frontend access
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]
